# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/securedoc_advanced
REDIS_URL=redis://localhost:6379

# Cryptography & Security
# 32-byte (64 hex characters) AES-256 master key
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_securedoc_advanced_development_token_2026
JWT_EXPIRES_IN=7d

# File Storage Vault
VAULT_STORAGE_DIR=./storage/vault

# Nodemailer / SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="SecureDoc Advanced <security@securedoc.internal>"
